# Copy this file to .env and set your Supabase Postgres connection string.
# Supabase dashboard: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" or direct connection string, and keep sslmode=require.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional overrides
# DB_SSL=true
# PG_POOL_MAX=10
# AVIP_SEED=1
# PORT=3000
# HOST=127.0.0.1
# AVIP_DATA_DIR=./data
# MOCK_PROVIDER_DOWN=1

# Hosted deployments: set both keys to stable 32-byte base64 values so
# encrypted APAAR values remain readable across restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AVIP_HMAC_KEY=
# AVIP_ENCRYPTION_KEY=
# AVIP_KEY_ID=k1-env
